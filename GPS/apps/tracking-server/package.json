{
  "name": "@transitlink/tracking-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "dev:local": "tsx src/dev.ts",
    "import-schedule": "tsx --env-file-if-exists=.env src/cli/importSchedule.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "stops": "tsx src/cli/stops.ts"
  },
  "dependencies": {
    "@transitlink/shared": "*",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
