# Copy to apps/tracking-server/.env (git-ignored).

PORT=4000
# Supabase → Project Settings → Database → Connection string (URI). Server-side only; never ship to clients.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Used only to verify user access tokens (GET /auth/v1/user). The anon key is public by design.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Browser/app origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Location history kept this many days, then purged.
LOCATION_RETENTION_DAYS=30

# Freshness thresholds (seconds): LIVE ≤ live, DELAYED ≤ delayed, STALE beyond; "offline" event after offline.
FRESHNESS_LIVE_SEC=5
FRESHNESS_DELAYED_SEC=15
FRESHNESS_OFFLINE_SEC=60
# Baseline bus speed for ETAs until trip history exists (km/h, including stops).
ETA_BASELINE_KMH=18

# Admin-only geocoding/routing suggestions. Public OSM servers allow light use only; self-host for more.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org
GEO_USER_AGENT=SafarSaathi-campus-bus-admin/0.1 (transport-office-email@example.edu)

SCHEDULE_TIMEZONE=Asia/Kolkata

# Free-seat counts from each bus's vision fusion service (ai_face repo, vision/service.py, one per bus).
# Keys are tracking bus ids (bus-<registration>); each service must run with VISION_BUS_ID = that bus's
# fleet number and the schedule's seat count, or its readings are published as unavailable.
# SEAT_SOURCES={"bus-uk07pa1696":"http://10.0.0.21:8000"}

# LOCAL DEVELOPMENT ONLY — accept dev:<profile-uuid> tokens instead of Supabase logins. Refused when NODE_ENV=production.
# DEV_AUTH=1
