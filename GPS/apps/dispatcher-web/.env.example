# mock = in-browser simulator (no backend needed); live = Siddhant's Socket.io/REST server
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000
# Sign-in for the Live GPS and Route Setup pages (Supabase → Project Settings → API; anon key only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Maps (real road routes). Leave both keys empty to use the keyless MapLibre map. ---
# Browser key: enable "Maps JavaScript API"; restrict to HTTP referrers (localhost:3000, your domain).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: your own Map ID (Cloud Console > Map Management). DEMO_MAP_ID is used if empty.
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Server key (never exposed to the browser): enable "Routes API"; restrict by API, not by referrer.
GOOGLE_ROUTES_API_KEY=

# Fallback map style when no Google key is set. OpenFreeMap needs no API key.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
