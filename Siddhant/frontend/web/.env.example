# Copy to frontend/web/.env.local and fill in (Supabase dashboard > Project Settings > API).
# The anon / publishable key is meant to be public; never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only on the computer with the bus camera: the camera agent (vision/camera_agent.py). When a driver picks their bus
# on the Staff page, the camera starts counting that bus. Leave unset everywhere else.
# VITE_CAMERA_AGENT_URL=http://127.0.0.1:8011
