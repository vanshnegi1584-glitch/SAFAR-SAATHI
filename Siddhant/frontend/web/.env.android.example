# Copy to frontend/web/.env.android (git-ignored) and build the APK with `npm run android:apk`.
# Vite also reads .env.local, so VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY come from there unless you set them here.
# Only the anon / publishable key may go into the APK; never the service_role / secret key or anything from backend/.env.

# The backend as the phone sees it. The APK has no Vite proxy, so this is the backend's own URL (no trailing slash).
# 192.168.137.1 is always the laptop's address on its Windows Mobile Hotspot. Start the demo with -Lan so the backend
# listens on it. If this changes, also change the host in android/app/src/main/res/xml/network_security_config.xml.
VITE_API_BASE=http://192.168.137.1:8000

# The camera agent is for the bus computer only: keep it empty so .env.local's value doesn't reach the APK.
VITE_CAMERA_AGENT_URL=
