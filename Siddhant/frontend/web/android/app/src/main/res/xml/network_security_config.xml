<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, except the demo laptop's backend on its Windows Mobile Hotspot (always 192.168.137.1).
     Keep this host in step with VITE_API_BASE in frontend/web/.env.android. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.137.1</domain>
    </domain-config>
</network-security-config>
