# Copy to backend/.env and fill in. Never commit .env.
# Supabase dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Only for older projects using the legacy shared JWT secret
# (Project Settings > API > JWT Settings). Leave unset if your project uses JWT signing keys.
# SUPABASE_JWT_SECRET=

# Supabase dashboard > Connect > Transaction pooler (port 6543). Server-side only; never put it in the frontend.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Only needed to run bulk_import_passengers.py. Project Settings > API > service_role secret.
# Grants full admin access to your project -- never put it in the frontend, never commit it.
# SUPABASE_SERVICE_ROLE_KEY=

# Tests use a separate file: backend/.env.test with
# TEST_DATABASE_URL=<a disposable dev database, never the demo project>
# TEST_AUTH_STUB=1   (only for plain local Postgres without Supabase's auth schema)

# Shared secret for POST /feeds/gps/{bus_id}: bus positions forwarded from the campus GPS tracking server
# (tools/gps_feed.py). Any long random string; the forwarder sends it as X-Feed-Key. Leave unset to turn the feed off.
# GPS_FEED_KEY=

# MQTT broker for device telemetry. Dev: python tools/broker.py. Pilot: mqtts://backend:PASSWORD@host:8883
MQTT_URL=mqtt://127.0.0.1:1883
